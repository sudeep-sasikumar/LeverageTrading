# For running on this PC: copy to .env (git-ignored) and fill in. Never commit real values.
# On the VPS these are entered as environment variables in Hostinger Docker Manager instead.
# 1. Create a bot with @BotFather in Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=
# 2. Send any message to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy result[0].message.chat.id
TELEGRAM_CHAT_ID=
# Only needed when the dashboard is reachable beyond this PC (VPS). Use a long random password.
DASHBOARD_PASSWORD=
# Optional
ACCOUNT_SIZE_USDT=
RISK_PER_TRADE=
MAX_SIGNALS_PER_DAY=
